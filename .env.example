# Copiar a .env (al lado de testing-mcp.exe) y completar. El .env no se comparte.
# Una variable definida en el entorno real gana sobre este archivo.

# --- MongoDB (obligatoria) ---
# URI completa con usuario y contrasena. Se recomienda un usuario de solo
# lectura sobre la base de pruebas. Si la contrasena tiene caracteres
# especiales (@ : / ? # %), van codificados (por ejemplo @ = %40).
# Ejemplo: mongodb://usuario:contrasena@servidor:27017/?authSource=admin
TESTING_MCP_MONGO_URI=

# Base de datos. Por defecto: testing_migracion
TESTING_MCP_MONGO_DB=testing_migracion

# --- Fichero de conocimiento ---
# Ruta relativa al directorio de trabajo o al ejecutable, o absoluta.
# Por defecto: conocimiento/flows.json
TESTING_MCP_CONOCIMIENTO=conocimiento/flows.json
# Formato de las salidas (test_outputs). Por defecto: conocimiento/salidas.json
TESTING_MCP_SALIDAS=conocimiento/salidas.json

# --- Limites ---
# Maximo de filas que una consulta devuelve al modelo. Por defecto: 20
TESTING_MCP_LIMITE_PANTALLA=20
# Tiempo maximo por consulta (formato 90s, 2m). Mongo tambien lo recibe
# (maxTimeMS). Leer el XML de todo un flow recorre todos sus mensajes.
# Por defecto: 120s
TESTING_MCP_MONGO_TIMEOUT=120s

# --- Fechas ---
# Zona en que se interpreta una fecha sin hora en desde/hasta (por ejemplo,
# 2026-10-01 = desde las 00:00 de ese dia en esta zona). Por defecto:
# Europe/Madrid
TESTING_MCP_ZONA_HORARIA=Europe/Madrid
